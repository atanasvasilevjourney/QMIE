# ════════════════════════════════════════════════════════════════════════
#  QMIE Scanner — Environment Configuration
#  Copy to `.env` and fill in. Never commit secrets.
# ════════════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
WORKERS=1
ENV=production

# ─── Webhook (optional ingress for Pine visualizer alerts) ──────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_me_with_64_hex_chars
WEBHOOK_REQUIRE_HMAC=true
WEBHOOK_MAX_AGE_SEC=60
WEBHOOK_ALLOW_IPS=

# ─── Storage ────────────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./data/qmie.db
# Optional Redis for cross-restart dedup (highly recommended in prod)
# REDIS_URL=redis://redis:6379/0
DEDUP_TTL_SEC=1800

# ─── Notifiers ──────────────────────────────────────────────────────────
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
DISCORD_USERNAME=QMIE
DISCORD_AVATAR_URL=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Scanner ────────────────────────────────────────────────────────────
# Data source: binance | bybit | okx
# Cloud VMs often get Binance 451 and Bybit 403. OKX SWAP is the
# geo-block fallback (USDT-margined perps). Not bit-exact vs BINANCE: charts.
SCAN_DATA_SOURCE=binance
SCAN_DATA_TIMEOUT_SEC=10.0
SCAN_MAX_CONCURRENCY=8

# Static symbol list (USDT-margined perps).
# OKX: POL/RENDER (not MATIC/RNDR). Omit FET (no SWAP) and 1000PEPE
# (different contract scale than PEPE). MATIC/RNDR still alias in the client.
SCAN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,POLUSDT,DOTUSDT,LTCUSDT,TRXUSDT,ATOMUSDT,NEARUSDT,APTUSDT,ARBUSDT,OPUSDT,SUIUSDT,INJUSDT,FILUSDT,RENDERUSDT,TIAUSDT,SEIUSDT,ORDIUSDT,WLDUSDT,PEPEUSDT,BONKUSDT,PYTHUSDT

# Auto-discover top-N by 24h volume in addition to the static list.
# 0 = static only.
SCAN_AUTO_UNIVERSE_TOP_N=0
SCAN_MIN_24H_QUOTE_VOLUME=50000000

# Timeframes to scan. Each fires once per closed bar.
# Frozen TMA OOS: 4h A/A+ is the edge; 1h dilutes PF. See docs/backtest-baseline.md
# and strategy/reviews/2026-08-17.md (SCAN_TIMEFRAMES=4h proposed, not applied).
SCAN_TIMEFRAMES=1h,4h
SCAN_LOOP_INTERVAL_SEC=30

# Higher-timeframe map for HTF confirmation (scan_tf:htf,...)
SCAN_HTF_MAP=15m:1h,1h:4h,4h:1d,1d:1w

# Min grade to ALERT on. A+ | A | B | C | REJECT
SCAN_MIN_ALERT_GRADE=A

# Signal weights (sum = 100). W_SUPERTREND is the Triple-EMA (9/90/199) stack weight.
W_SUPERTREND=20
W_EMA=15
W_RSI=15
W_ADX=15
W_HTF=20
W_SR=10
W_VOL=5

# ─── Volatility / trend / crowding filters ──────────────────────────────
SIG_MIN_ATR_PCT=0.10
SIG_MAX_ATR_PCT=8.0
SIG_MIN_ADX=0
SIG_FUNDING_RATE_THRESHOLD=0.001
SIG_MAX_SIGNALS_PER_SYMBOL_PER_DAY=4

# ─── Journal (manual fills vs alerts; no broker) ────────────────────────
# Set JOURNAL_OOS_WIN_PCT after a frozen backtest (e.g. 52.0). Empty = no drift alert.
JOURNAL_OOS_WIN_PCT=
JOURNAL_DRIFT_PTS=5.0
JOURNAL_MIN_FILLS=30

# ─── Paper book (auto-fill alerts; never an order) ──────────────────────
# Each ENTRY gets a journal row at signal_price. Size = notional / price.
# Closed bars that touch SL (first) or TP write a QMIE-Paper EXIT + PnL.
PAPER_ENABLED=true
PAPER_NOTIONAL_USDT=1000
PAPER_NOTIFY_EXITS=false

# ─── Ranked asset allocation (which alerts to take; suggested size) ─────
# ranked = top N long + top N short per TF (crypto swing book).
# all    = firehose every grade that passes SCAN_MIN_ALERT_GRADE.
# Suggested weight_pct is a 100-point risk budget, not an order.
ALLOC_MODE=ranked
ALLOC_TOP_LONG=3
ALLOC_TOP_SHORT=3
ALLOC_MIN_GRADE=A
ALLOC_WEIGHTING=rank
ALLOC_CLUSTER_MAX=1

# ARS rotation (set ALLOC_MODE=rotation). Lookback ROC only — no RSI/MACD.
# Defensive 1: all scores < ALLOC_NORM_THRESHOLD → CASH.
# Defensive 2: BTC weak → cash | paxg | paxg_then_cash | off.
# Dual: 50/50 the top two names that clear the threshold.
ALLOC_NORM_LENGTH=20
ALLOC_NORM_THRESHOLD=0.0
ALLOC_MA_FILTER=false
ALLOC_MA_TYPE=ema
ALLOC_MA_LENGTH=50
ALLOC_DUAL=false
ALLOC_DEFENSIVE2=cash
ALLOC_BTC_SYMBOL=BTCUSDT
ALLOC_PAXG_SYMBOL=PAXGUSDT

# ─── Daily Trend Radar (RGG + coil breakouts; signal-only) ──────────────
# Fires once per closed 1D bar. Does NOT place orders.
RADAR_ENABLED=true
RADAR_ADX_LENGTH=14
RADAR_ENTER_ADX=25.0
RADAR_EXIT_ADX=20.0
RADAR_COIL_LOOKBACK=20
RADAR_COIL_MAX_WIDTH_PCT=15.0
RADAR_FRESH_FLIP_DAYS=3
RADAR_LATE_STAGE_DAYS=30
RADAR_LATE_STAGE_MOVE_PCT=50.0
RADAR_KLINE_LIMIT=250
# Digests are opt-in. Data still fills GET /radar either way.
RADAR_NOTIFY=false
RADAR_MIN_COVERAGE_PCT=50.0
# Closed-1D GREY→GREEN/RED or coil UP/DOWN → persist as QMIE-DailyBreakout (BUY/SELL).
# Manual entry only. Not an A/A+ grade.
RADAR_DISPATCH_TREND_START=true
# Replay last N closed 1D bars so a missed coil-UP (SOL-style) is still dispatched.
RADAR_SETUP_LOOKBACK_BARS=7

# ─── TradingView deep-link prefix ───────────────────────────────────────
# BINANCE shows USDT perps. Use BYBIT if you scan via bybit and want
# the deep-link to land on Bybit data. There is no TradingView MCP here;
# the visualizer is pine/quant_visualizer.pine + this deep-link.
TV_CHART_PREFIX=BINANCE

# ─── OpenAI analysis overlay (optional; never scores, never orders) ─────
# Empty key = deterministic template Take. Levels always come from scanner
# ATR SL / 1R / TP — the model never owns prices. Do not add the openai
# SDK; the server calls /v1/chat/completions via aiohttp.
# GET /agents/analysis/{id} is on-demand. The 12s desk briefing poll
# only reports whether a key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SEC=20
OPENAI_BASE_URL=https://api.openai.com/v1
